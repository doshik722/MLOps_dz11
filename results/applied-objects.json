          "alerts.yml": "groups:\n  - name: hw11\n    rules:\n      - alert: HighTTFC\n        expr: histogram_quantile(0.95, sum by(le) (rate(api_ttfc_seconds_bucket[30s]))) > 0.8 and sum(increase(api_ttfc_seconds_count[30s])) >= 20\n        for: 15s\n        labels: {severity: warning}\n        annotations: {summary: 'p95 TTFC > 0.8 s; минимум 20 наблюдений за 30 s'}\n      - alert: HighRejectionRatio\n        expr: sum(rate(api_requests_total{outcome=\"rejected\"}[30s])) / sum(rate(api_requests_total[30s])) > 0.1 and sum(increase(api_requests_total[30s])) >= 20\n        for: 15s\n        labels: {severity: warning}\n        annotations: {summary: 'Отказов > 10%; минимум 20 исходов за 30 s'}\n",
          "prometheus.yml": "global:\n  scrape_interval: 2s\n  evaluation_interval: 5s\nrule_files: [/etc/prometheus/alerts.yml]\nscrape_configs:\n  - job_name: api\n    kubernetes_sd_configs:\n      - role: pod\n        namespaces: {names: [hw11]}\n    relabel_configs:\n      - {source_labels: [__meta_kubernetes_pod_label_app], regex: api, action: keep}\n      - {source_labels: [__meta_kubernetes_pod_container_port_number], regex: '8080', action: keep}\n      - {source_labels: [__meta_kubernetes_pod_name], target_label: pod}\n  - job_name: state\n    static_configs: [{targets: ['state:8080']}]\n  - job_name: cadvisor\n    scheme: https\n    bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token\n    tls_config: {insecure_skip_verify: true}\n    kubernetes_sd_configs: [{role: node}]\n    relabel_configs:\n      - {target_label: __address__, replacement: 'kubernetes.default.svc:443'}\n      - source_labels: [__meta_kubernetes_node_name]\n        target_label: __metrics_path__\n        replacement: /api/v1/nodes/${1}/proxy/metrics/cadvisor\n"
        },
